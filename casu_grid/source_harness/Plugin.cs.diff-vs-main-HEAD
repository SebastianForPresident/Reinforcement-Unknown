+                    simulated = limb != null && limb.rb != null && limb.rb.simulated,
+                    position = Vector3Fields(limb == null ? Vector3.zero : limb.transform.position),
+                    velocity = Vector2Fields(limb == null || limb.rb == null ? Vector2.zero : limb.rb.velocity),
