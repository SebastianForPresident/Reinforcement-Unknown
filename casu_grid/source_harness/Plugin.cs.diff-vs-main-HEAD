+                contacts = CaptureContacts(__instance),
+                nearbyTiles = PPOTerrainDiagnostics.NearbyTiles(__instance),
+                shock = __instance.shock,
+                consciousness = __instance.consciousness,
+                conscious = __instance.conscious,
+                averagePain = __instance.averagePain,
+                liquidRagdollBar = __instance.liquidRagdollBar,
+                liquidSlipTime = __instance.liquidSlipTime,
+                energy = __instance.energy,
+                stamina = __instance.stamina,
+                legSpeedMult = __instance.legSpeedMult,
+                actualStaminaStrength = __instance.actualStaminaStrength,
+                currentWeightMovementMult = __instance.currentWeightMovementMult,
+                currentTemperatureMovementMult = __instance.currentTemperatureMovementMult,
+                temporarySlowdown = __instance.temporarySlowdown,
+                overEncumberance = __instance.overEncumberance,
