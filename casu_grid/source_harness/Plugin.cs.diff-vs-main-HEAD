+static class PPOTerrainDiagnostics
+{
+    public static object NearbyTiles(Body body)
+    {
+        WorldGeneration world = WorldGeneration.world;
+        if (world == null || body == null) return new object[0];
+        Vector2Int center = world.WorldToBlockPos(body.transform.position);
+        var tiles = new List<object>();
+        for (int dx = -1; dx <= 1; dx++)
+        for (int dy = -2; dy <= 3; dy++)
+        {
+            Vector2Int position = center + new Vector2Int(dx, dy);
+            ushort id = world.GetBlock(position);
+            BlockInfo info = world.GetBlockInfo(id);
+            tiles.Add(new { x = position.x, y = position.y, dx, dy, id, name = info == null ? null : info.name });
+        }
+        return tiles;
+    }
+
+    public static object Contacts(Body body)
+    {
+        if (body == null || body.rb == null) return new object[0];
+        var contacts = new ContactPoint2D[32];
+        int count = body.rb.GetContacts(contacts);
+        return contacts.Take(count).Select(contact => new {
+            point = new[] { contact.point.x, contact.point.y },
+            normal = new[] { contact.normal.x, contact.normal.y },
+            separation = contact.separation,
+            collider = contact.collider == null ? "<null>" : contact.collider.gameObject.name,
+            otherCollider = contact.otherCollider == null ? "<null>" : contact.otherCollider.gameObject.name
+        }).ToArray();
+    }
+}
