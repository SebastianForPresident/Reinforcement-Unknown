+// Opt-in per-physics-tick player telemetry, written after the Unity 2D
+// solver and before the harness's deterministic manual Body.Update schedule.
+static class PPOPlayerPhysicsTrace
+{
+    static readonly FieldRef<Body, BlockInfo> standingOnRef =
+        FieldRefAccess<Body, BlockInfo>("standingOn");
+
+    public static void Record(Body body)
+    {
+        if (Environment.GetEnvironmentVariable("PPO_DIAG_PLAYER_PHYSICS_TRACE") != "1" ||
+            body == null || PlayerCamera.main == null || PlayerCamera.main.body != body)
+            return;
+        try
+        {
+            string root = Environment.GetEnvironmentVariable("PPO_COUNTERFACTUAL_DIAGNOSTICS_ROOT");
+            string session = Environment.GetEnvironmentVariable("PPO_COUNTERFACTUAL_SESSION");
+            if (string.IsNullOrWhiteSpace(root) || !Path.IsPathRooted(root))
+                throw new InvalidOperationException("physics trace requires an absolute diagnostics root");
+            if (string.IsNullOrWhiteSpace(session) || Path.GetFileName(session) != session ||
+                session.Any(ch => !(char.IsLetterOrDigit(ch) || ch == '-' || ch == '_')))
+                session = "unscoped";
+            // BoundaryProtocol owns the session's "unity" directory and
+            // requires it to be absent at CF_HELLO. Keep physics telemetry in
+            // a sibling so listeners can reserve the session before launch.
+            string dir = Path.Combine(root, session, "physics-trace");
+            Directory.CreateDirectory(dir);
+            WorldGeneration world = WorldGeneration.world;
+            Vector2 position = body.transform.position;
+            Vector2Int tile = world == null ? Vector2Int.zero : world.WorldToBlockPos(position);
+            ushort blockId = world == null ? (ushort)0 : world.GetBlock(tile);
+            BlockInfo tileInfo = world == null ? null : world.GetBlockInfo(blockId);
+            Vector2 velocity = body.rb == null ? Vector2.zero : body.rb.velocity;
+            var row = new {
+                utc = DateTime.UtcNow.ToString("o"),
+                physicsFixedUpdateIndex = PPOBridge.DiagnosticFixedUpdateIndex,
+                bodyUpdateIndex = PPOBridge.DiagnosticBodyUpdateIndex,
+                policyPhysicsTick = PPOBridge.DiagnosticMacrostepPhysicsTicks + 1,
+                actionSequence = PPOBridge.DiagnosticActionSequence,
+                frame = Time.frameCount,
+                fixedTime = Time.fixedTime,
+                fixedDeltaTime = Time.fixedDeltaTime,
+                position = new[] { position.x, position.y },
+                velocity = new[] { velocity.x, velocity.y },
+                mass = body.rb == null ? 0f : body.rb.mass,
+                standing = body.standing,
+                grounded = body.grounded,
+                mainColliderEnabled = body.col != null && body.col.enabled,
+                standingOn = standingOnRef(body) == null ? null : standingOnRef(body).name,
+                tile = new { x = tile.x, y = tile.y, id = blockId, name = tileInfo == null ? null : tileInfo.name },
+                nearbyTiles = PPOTerrainDiagnostics.NearbyTiles(body),
+                contacts = PPOTerrainDiagnostics.Contacts(body),
+                shock = body.shock,
+                consciousness = body.consciousness,
+                averagePain = body.averagePain,
+                temperature = body.temperature,
+                temperatureMovementMultiplier = body.currentTemperatureMovementMult,
+                legSpeedMult = body.legSpeedMult,
+                actualMoveForce = body.actualMoveForce,
+                actualMaxSpeed = body.actualMaxSpeed,
+                actualJumpSpeed = body.actualJumpSpeed,
+                stamina = body.stamina,
+                energy = body.energy,
+                totalEncumberance = body.totalEncumberance,
+                liquidSlipTime = body.liquidSlipTime,
+                action = new {
+                    move = PPOBridge.CurrentAction.MoveDirection,
+                    vertical = PPOBridge.CurrentAction.VerticalMovement,
+                    jump = PPOBridge.CurrentAction.Jump,
+                    crouch = PPOBridge.CurrentAction.Crouch,
+                    ragdoll = PPOBridge.CurrentAction.Ragdoll
+                }
+            };
+            File.AppendAllText(Path.Combine(dir, "player-physics.jsonl"),
+                JsonConvert.SerializeObject(row) + Environment.NewLine);
+        }
+        catch (Exception ex)
+        {
+            Debug.LogError("PPO player physics trace failed: " + ex);
+        }
+    }
+}
