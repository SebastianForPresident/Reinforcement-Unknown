+    def _run_ticks_grouped(self) -> None:
+        """The ``action_decimation`` physics ticks of one decision with the worlds split over two PhysX scenes.
+
+        Per scene the sequence of operations is exactly that of :meth:`_physics_tick` (pre-phase, tensor writes, step, read-back,
+        post-phase, crouch shapes); the scenes are software-pipelined so that one scene's Python/USD work runs while the other
+        scene's ``simulate_scene`` is in flight (``CASU_TWO_SCENE_PIPELINE=0`` runs them back to back instead).
+        """
+        clock = time.perf_counter
+        iface, ids, dt = self._physx_iface, self._scene_path_ids(), self._physics_dt_exact
+        ticks = self.cfg.action_decimation
+        groups = range(len(self._group_views))
+        pipeline = os.environ.get("CASU_TWO_SCENE_PIPELINE", "1") != "0"
+        now = self.sim.current_time
+        if pipeline:
+            def launch(g):
+                t = clock()
+                iface.simulate_scene(ids[g], dt, now)
+                self.timers["diag_simulate_call"] += clock() - t
+            for g in groups:
+                self._group_pre(g)
+                launch(g)
+            for tick in range(1, ticks + 1):
+                for g in groups:
+                    t0 = clock()
+                    iface.fetch_results_scene(ids[g])
+                    self.timers["physx_step"] += clock() - t0
+                    self._group_post(g, tick)
+                    if tick < ticks:
+                        self._group_pre(g)
+                        launch(g)
+        else:
+            for tick in range(1, ticks + 1):
+                for g in groups:
+                    self._group_pre(g)
+                    t0 = clock()
+                    iface.simulate_scene(ids[g], dt, now)
+                    iface.fetch_results_scene(ids[g])
+                    self.timers["physx_step"] += clock() - t0
+                    self._group_post(g, tick)
+        self.player.update(self.cfg.physics_dt * ticks)
